---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { createSupabaseServerClient, getAdminUser } from "../../lib/supabase";

type Feedback = {
  type: "error";
  message: string;
};

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

if (await getAdminUser(supabase)) {
  return Astro.redirect("/admin");
}

let feedback: Feedback | null = null;
let email = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  email = String(formData.get("email") ?? "").trim();
  const password = String(formData.get("password") ?? "");

  if (!email || !password) {
    feedback = {
      type: "error",
      message: "Ingresa correo y contraseña.",
    };
  } else {
    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      feedback = {
        type: "error",
        message: "Credenciales inválidas.",
      };
    } else if (!(await getAdminUser(supabase))) {
      await supabase.auth.signOut();
      feedback = {
        type: "error",
        message: "Sin permisos para entrar.",
      };
    } else {
      return Astro.redirect("/admin");
    }
  }
}
---

<BaseLayout title="GymLabs Admin" description="Ingreso de GymLabs">
  <main class="login-shell">
    <section class="login-panel">
      <div class="login-copy">
        <p class="eyebrow">GymLabs HQ</p>
        <h1>Iniciar sesión</h1>
        <p>Solo personal autorizado</p>
      </div>

      {feedback && <p class="feedback is-error">{feedback.message}</p>}

      <form class="login-form" method="POST">
        <label class="field">
          <span>Correo</span>
          <input class="text-input" type="email" name="email" value={email} autocomplete="email" required />
        </label>

        <label class="field">
          <span>Contraseña</span>
          <input class="text-input" type="password" name="password" autocomplete="current-password" required />
        </label>

        <button class="primary-button" type="submit">Ingresar</button>
      </form>
    </section>
  </main>
</BaseLayout>

<style>
  .login-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      linear-gradient(180deg, rgba(2, 6, 23, 0.92), rgba(15, 23, 42, 0.88)),
      url("https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=1400&q=80")
      center / cover;
  }

  .login-panel {
    width: min(420px, 100%);
    display: grid;
    gap: 1rem;
    border: 1px solid rgba(203, 213, 225, 0.26);
    border-radius: 8px;
    padding: clamp(1.25rem, 4vw, 2rem);
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 26px 80px rgba(2, 6, 23, 0.32);
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    color: #64748b;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #0f172a;
    font-size: clamp(1.7rem, 5vw, 2.15rem);
  }

  .login-copy p:last-child {
    margin: 0.6rem 0 0;
    color: #64748b;
  }

  .login-form {
    display: grid;
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field span {
    color: #334155;
    font-weight: 700;
  }

  .text-input {
    width: 100%;
    min-height: 46px;
    box-sizing: border-box;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.8rem 0.9rem;
    color: #0f172a;
    font: inherit;
  }

  .primary-button {
    min-height: 46px;
    border: 0;
    border-radius: 8px;
    background: #0f172a;
    color: #fff;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .feedback {
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
  }

  .feedback.is-error {
    color: #8a1c1c;
    background: #fdecec;
    border: 1px solid #f3c2c2;
  }
</style>
