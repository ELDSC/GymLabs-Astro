---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import ProductDashboardView from "../components/product-dashboard/ProductDashboardView.astro";
import { getProductImageUrl, getRequiredEnv, supabase } from "../lib/supabase";

type Feedback = {
  type: "success" | "error";
  message: string;
};

function normalizeSearchValue(value: string) {
  return value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
}

function slugify(value: string) {
  return normalizeSearchValue(value)
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "")
    .slice(0, 50);
}

function parseCurrency(value: FormDataEntryValue | null) {
  const text = String(value ?? "").trim();
  if (!text) return null;

  const parsed = Number(text);
  return Number.isFinite(parsed) ? parsed : Number.NaN;
}

function parseInteger(value: FormDataEntryValue | null) {
  const text = String(value ?? "").trim();
  if (!text) return null;

  const parsed = Number.parseInt(text, 10);
  return Number.isFinite(parsed) ? parsed : Number.NaN;
}

const { data: categoryRows, error: categoriesError } = await supabase
  .from("categories")
  .select("id, name")
  .eq("is_active", true)
  .order("sort_order", { ascending: true });

const defaultCategoryId = categoryRows?.[0]?.id ?? null;
const categories = (categoryRows ?? []).map((category) => ({
  id: category.id,
  name: category.name,
}));
let feedback: Feedback | null = categoriesError
  ? { type: "error", message: `No se pudieron cargar las categorías: ${categoriesError.message}` }
  : null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") ?? "");

  if (action === "delete") {
    const productId = String(formData.get("productId") ?? "").trim();

    if (!productId) {
      feedback = { type: "error", message: "No se recibió el producto a eliminar." };
    } else {
      const { data: existingProduct } = await supabase
        .from("products")
        .select("image_storage_key")
        .eq("id", productId)
        .maybeSingle();

      const { error } = await supabase.from("products").delete().eq("id", productId);

      if (error) {
        feedback = { type: "error", message: `No se pudo eliminar el producto: ${error.message}` };
      } else {
        if (existingProduct?.image_storage_key) {
          const bucket = getRequiredEnv("SUPABASE_PRODUCT_IMAGE_BUCKET");
          await supabase.storage.from(bucket).remove([existingProduct.image_storage_key]);
        }

        feedback = { type: "success", message: "Producto eliminado." };
      }
    }
  }

  if (action === "save") {
    const productId = String(formData.get("productId") ?? "").trim();
    const categoryId = String(formData.get("categoryId") ?? "").trim();
    const name = String(formData.get("name") ?? "").trim();
    const slugInput = String(formData.get("slug") ?? "").trim();
    const skuInput = String(formData.get("sku") ?? "").trim();
    const description = String(formData.get("description") ?? "").trim() || null;
    const price = parseCurrency(formData.get("price"));
    const compareAtPrice = parseCurrency(formData.get("compareAtPrice"));
    const stock = parseInteger(formData.get("stock"));
    const isActive = formData.get("isActive") === "on";
    const isTopSeller = formData.get("isTopSeller") === "on";
    const removeImage = formData.get("removeImage") === "true";
    const imageFile = formData.get("image");
    const slug = slugify(slugInput || name);
    const sku = skuInput || `DASH-${Date.now()}`;

    if (!name) {
      feedback = { type: "error", message: "Debes indicar el nombre del producto." };
    } else if (!slug) {
      feedback = { type: "error", message: "El slug no puede quedar vacío." };
    } else if (!categoryId) {
      feedback = { type: "error", message: "Debes seleccionar una categoría." };
    } else if (!sku) {
      feedback = { type: "error", message: "Debes indicar el SKU del producto." };
    } else if (price === null || Number.isNaN(price) || price < 0) {
      feedback = { type: "error", message: "El precio debe ser un número mayor o igual a 0." };
    } else if (compareAtPrice !== null && (Number.isNaN(compareAtPrice) || compareAtPrice < price)) {
      feedback = {
        type: "error",
        message: "El precio comparativo debe ser mayor o igual al precio base.",
      };
    } else if (stock === null || Number.isNaN(stock) || stock < 0) {
      feedback = { type: "error", message: "El stock debe ser un entero mayor o igual a 0." };
    } else {
      let previousImageStorageKey: string | null = null;
      let imageStorageKey: string | null = null;
      const bucket = getRequiredEnv("SUPABASE_PRODUCT_IMAGE_BUCKET");

      if (productId) {
        const { data: existingProduct, error: existingProductError } = await supabase
          .from("products")
          .select("image_storage_key")
          .eq("id", productId)
          .maybeSingle();

        if (existingProductError) {
          feedback = {
            type: "error",
            message: `No se pudo cargar el producto a editar: ${existingProductError.message}`,
          };
        } else {
          previousImageStorageKey = existingProduct?.image_storage_key ?? null;
          imageStorageKey = previousImageStorageKey;
        }
      }

      if (!feedback && removeImage) {
        imageStorageKey = null;
      }

      if ((!feedback || feedback.type !== "error") && imageFile instanceof File && imageFile.size > 0) {
        const extension = imageFile.name.includes(".")
          ? imageFile.name.split(".").pop()?.toLowerCase()
          : "bin";
        imageStorageKey = `dashboard/${slug}-${Date.now()}.${extension || "bin"}`;

        const { error: uploadError } = await supabase.storage
          .from(bucket)
          .upload(imageStorageKey, imageFile, {
            upsert: false,
            contentType: imageFile.type || undefined,
          });

        if (uploadError) {
          feedback = {
            type: "error",
            message: `No se pudo subir la imagen del producto: ${uploadError.message}`,
          };
        }
      }

      if (!feedback || feedback.type !== "error") {
        const payload = {
          category_id: categoryId || defaultCategoryId!,
          compare_at_price: compareAtPrice,
          description,
          image_storage_key: imageStorageKey,
          is_active: isActive,
          is_top_seller: isTopSeller,
          name,
          name_search: normalizeSearchValue(name),
          price,
          sku,
          slug,
          stock,
        };

        const { error } = productId
          ? await supabase.from("products").update(payload).eq("id", productId)
          : await supabase.from("products").insert(payload);

        if (error) {
          feedback = {
            type: "error",
            message: `No se pudo ${productId ? "guardar" : "agregar"} el producto: ${error.message}`,
          };
        } else {
          if (productId && previousImageStorageKey && imageStorageKey && previousImageStorageKey !== imageStorageKey) {
            await supabase.storage.from(bucket).remove([previousImageStorageKey]);
          }

          feedback = {
            type: "success",
            message: productId ? "Producto actualizado." : "Producto agregado.",
          };
        }
      }
    }
  }
}

const { data: productsData, error: productsError } = await supabase
  .from("products")
  .select(`
    id,
    category_id,
    name,
    slug,
    sku,
    description,
    price,
    compare_at_price,
    stock,
    is_active,
    is_top_seller,
    image_storage_key
  `)
  .order("name", { ascending: true });

if (productsError) {
  feedback = {
    type: "error",
    message: `No se pudieron cargar los productos: ${productsError.message}`,
  };
}

const products = (productsData ?? []).map((product) => ({
  id: product.id,
  categoryId: product.category_id,
  name: product.name,
  slug: product.slug,
  sku: product.sku,
  description: product.description ?? "",
  price: Number(product.price),
  compareAtPrice:
    product.compare_at_price === null ? null : Number(product.compare_at_price),
  stock: product.stock,
  isActive: product.is_active,
  isTopSeller: product.is_top_seller,
  imageStorageKey: product.image_storage_key,
  imageUrl: product.image_storage_key ? getProductImageUrl(product.image_storage_key) : null,
}));
---

<BaseLayout title="Product Dashboard" description="Administración básica de productos">
  <ProductDashboardView products={products} categories={categories} feedback={feedback} />
</BaseLayout>
