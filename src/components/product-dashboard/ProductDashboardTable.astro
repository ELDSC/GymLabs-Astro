---
interface ProductItem {
  id: string;
  name: string;
  categoryId: string;
  slug: string;
  sku: string;
  description: string;
  price: number;
  compareAtPrice: number | null;
  stock: number;
  isActive: boolean;
  isTopSeller: boolean;
  imageStorageKey: string | null;
  imageUrl: string | null;
}

interface Props {
  products: ProductItem[];
}

const { products } = Astro.props;
---

<div class="table-shell">
  <div class="table-head" aria-hidden="true">
    <span>Nombre</span>
    <span>Acción</span>
  </div>

  <div class="table-body" role="table" aria-label="Listado de productos">
    {products.length === 0 ? (
      <p class="empty-state">No hay productos registrados.</p>
    ) : (
      products.map((product) => (
        <div class="table-row" role="row">
          <div class="name-cell" role="cell">{product.name}</div>
          <div class="action-cell" role="cell">
            <button
              class="edit-button"
              type="button"
              aria-label={`Editar ${product.name}`}
              data-edit-product
              data-product={JSON.stringify(product)}
            >
              Editar
            </button>
          </div>
        </div>
      ))
    )}
  </div>
</div>

<style>
  .table-shell {
    padding: 0 1.5rem 1.5rem;
  }

  .table-head,
  .table-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 64px;
    align-items: center;
  }

  .table-head {
    padding: 0.85rem 1rem;
    color: #475569;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 2px solid #cbd5e1;
  }

  .table-body {
    border: 1px solid #d9e2ec;
    border-top: 0;
  }

  .table-row {
    min-height: 56px;
    padding: 0 1rem;
    background:
      linear-gradient(90deg, rgba(248, 250, 252, 0.9) 0, rgba(248, 250, 252, 0.9) 1px, transparent 1px) 0 0 / 100% 100%,
      linear-gradient(180deg, transparent calc(100% - 1px), #e2e8f0 calc(100% - 1px));
  }

  .table-row:nth-child(even) {
    background-color: #fcfdff;
  }

  .name-cell {
    padding-right: 1rem;
    color: #0f172a;
    word-break: break-word;
  }

  .action-cell {
    display: flex;
    justify-content: center;
  }

  .edit-button {
    min-width: 34px;
    height: 34px;
    border: 1px solid #d0d7e2;
    border-radius: 8px;
    background: #fff;
    color: #0f172a;
    font: inherit;
    padding: 0 0.75rem;
    cursor: pointer;
  }

  .edit-button:hover {
    background: #eff6ff;
    border-color: #93c5fd;
  }

  .empty-state {
    margin: 0;
    padding: 1.5rem 1rem;
    color: #64748b;
  }

  @media (max-width: 640px) {
    .table-shell {
      padding: 0 1rem 1rem;
    }

    .table-head,
    .table-row {
      grid-template-columns: minmax(0, 1fr) 52px;
    }
  }
</style>
