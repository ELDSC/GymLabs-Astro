---
import AddProductDialog from "./AddProductDialog.astro";
import ProductDashboardTable from "./ProductDashboardTable.astro";
import ProductDashboardToolbar from "./ProductDashboardToolbar.astro";

interface ProductItem {
  id: string;
  categoryId: string;
  name: string;
  slug: string;
  sku: string;
  description: string;
  price: number;
  compareAtPrice: number | null;
  stock: number;
  isActive: boolean;
  isTopSeller: boolean;
  imageStorageKey: string | null;
  imageUrl: string | null;
}

interface CategoryItem {
  id: string;
  name: string;
}

interface Feedback {
  type: "success" | "error";
  message: string;
}

interface Props {
  products: ProductItem[];
  categories: CategoryItem[];
  feedback?: Feedback | null;
}

const { products, categories, feedback = null } = Astro.props;
---

<section class="dashboard-shell">
  <div class="dashboard-card">
    <ProductDashboardToolbar count={products.length} />

    {feedback && (
      <p class:list={["feedback", feedback.type === "error" ? "is-error" : "is-success"]}>
        {feedback.message}
      </p>
    )}

    <ProductDashboardTable products={products} />
  </div>

  <AddProductDialog categories={categories} />
</section>

<style>
  .dashboard-shell {
    min-height: 100vh;
    padding: 2rem;
    background:
      linear-gradient(180deg, #f5f7fb 0%, #eef2f7 100%);
  }

  .dashboard-card {
    width: min(960px, 100%);
    margin: 0 auto;
    background: #fff;
    border: 1px solid #d8e0ea;
    border-radius: 18px;
    box-shadow: 0 22px 60px rgba(15, 23, 42, 0.08);
    overflow: hidden;
  }

  .feedback {
    margin: 0 1.5rem 1rem;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    font-size: 0.95rem;
    border: 1px solid transparent;
  }

  .feedback.is-success {
    color: #0d5c3a;
    background: #eaf8f1;
    border-color: #bbe7ce;
  }

  .feedback.is-error {
    color: #8a1c1c;
    background: #fdecec;
    border-color: #f3c2c2;
  }

  @media (max-width: 720px) {
    .dashboard-shell {
      padding: 1rem;
    }
  }
</style>
