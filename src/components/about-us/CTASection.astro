---
import Button from "../ui/Button.astro";
---

<section class="cta-section">
    <div class="cta-container">
        <div class="cta-content">
            <h2 class="cta-title">Transforma tu Entrenamiento</h2>
            <p class="cta-description">
                En GymLabs creemos que el fitness es más que ejercicio. Es un
                estilo de vida. Únete a nuestra comunidad y alcanza tus
                objetivos con tecnología de punta y entrenadores expertos.
            </p>

            <div class="cta-buttons">
                <Button
                    text="Comienza Ahora"
                    href="#ofertas"
                    variant="primary"
                />
                <Button
                    text="Más Información"
                    href="#categorias"
                    variant="secondary"
                />
            </div>
        </div>

        <div class="cta-image">
            <div class="image-placeholder">
                <img src="/gym-cta.jpg" alt="GymLabs CTA" />
            </div>
        </div>
    </div>
</section>

<style>
    .cta-section {
        background: var(--bg-base);
        padding: 3rem 1rem;
        margin: 2rem 0;
    }

    .cta-container {
        padding: 20px;
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
        transition: all 0.4s ease;
    }

    .cta-content {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        transition: all 0.4s ease;
    }

    .cta-title {
        font-family: var(--font-primary);
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.2;
        transition: font-size 0.4s ease;
    }

    .cta-description {
        font-family: var(--font-primary);
        font-size: 1.1rem;
        color: var(--text-secondary);
        line-height: 1.6;
        transition: font-size 0.4s ease;
    }

    .cta-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        transition: all 0.4s ease;
    }

    .cta-image {
        position: relative;
        overflow: hidden;
        border-radius: 1rem;
        border: 2px solid var(--border-color);
        transition: all 0.4s ease;
    }

    .image-placeholder {
        width: 100%;
        aspect-ratio: 1;
        background: var(--bg-surface);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        transition: all 0.4s ease;
    }

    .image-placeholder img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .cta-image:hover img {
        transform: scale(1.05);
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .cta-container {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        .cta-image {
            width: 80%;
            height: auto;
            margin: 0 auto;
        }
        .cta-buttons {
            flex-direction: column;
            width: 100%;
            height: 100px;
        }
        .image-placeholder {
            aspect-ratio: 1.2/1;
        }
    }
    @media (max-width: 768px) {
        .cta-container {
            grid-template-columns: 1fr;
            gap: 1.5rem;
            padding: 15px;
        }
        .cta-title {
            font-size: clamp(1.5rem, 4vw, 2.5rem);
        }
        .cta-description {
            font-size: 0.95rem;
        }
        .cta-buttons {
            flex-direction: column;
            width: 100%;
            height: 100px;
        }
        .cta-image {
            width: 70%;
            height: auto;
            margin: 0 auto;
        }
        .image-placeholder {
            aspect-ratio: 1.3/1;
        }
        .cta-section {
            padding: 2rem 1rem;
        }
    }
    @media (max-width: 425px) {
        .cta-container {
            gap: 1rem;
            padding: 10px;
        }
        .cta-title {
            font-size: clamp(1.25rem, 3vw, 2rem);
        }
        .cta-description {
            font-size: 0.9rem;
        }
        .cta-image {
            width: 60%;
            height: auto;
        }
        .image-placeholder {
            aspect-ratio: 1.4/1;
        }
    }
    @media (max-width: 375px) {
        .cta-container {
            gap: 0.8rem;
            padding: 8px;
        }
        .cta-title {
            font-size: clamp(1.1rem, 2.5vw, 1.75rem);
        }
        .cta-description {
            font-size: 0.85rem;
        }
        .cta-image {
            width: 50%;
            height: auto;
        }
        .image-placeholder {
            aspect-ratio: 1.5/1;
        }
    }
    @media (max-width: 320px) {
        .cta-container {
            gap: 0.6rem;
            padding: 5px;
        }
        .cta-title {
            font-size: clamp(1rem, 2vw, 1.5rem);
        }
        .cta-description {
            font-size: 0.8rem;
        }
        .cta-image {
            width: 45%;
            height: auto;
        }
        .image-placeholder {
            aspect-ratio: 1.6/1;
        }
    }
</style>
