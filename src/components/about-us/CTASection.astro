---
import Button from "../ui/Button.astro";
---
<section class="cta">
  <div class="cta__bg">
    <div class="cta__orb cta__orb--1"></div>
    <div class="cta__orb cta__orb--2"></div>
  </div>

  <div class="cta__container">
    <div class="cta__content">
      <div class="cta__badge">
        <span class="badge__dot"></span>
        <span>Únete hoy</span>
      </div>

      <h2 class="cta__title">
        ¿Listo para llevar tu<br />
        <em>rendimiento al límite?</em>
      </h2>

      <p class="cta__text">
        Más de 10,000 atletas ya transformaron su entrenamiento con GymLabs.
        Empieza hoy con una asesoría gratuita y descubre cuál es tu stack ideal.
      </p>

      <div class="cta-buttons">
                <Button
                    text="Comienza Ahora"
                    href="/shop"
                    variant="primary"
                />
                <Button
                    text="Conócenos"
                    href="/contacto"
                    variant="secondary"
                />
            </div>


      <div class="cta__trust">
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>Envío gratis +S/.100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>Garantía 30 días</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>Asesoría gratuita</span>
        </div>
      </div>
    </div>

    <div class="cta__deco">
      <div class="deco__ring deco__ring--1"></div>
      <div class="deco__ring deco__ring--2"></div>
      <div class="deco__ring deco__ring--3"></div>
      <div class="deco__center">
        <span>GL</span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 120px 24px;
    position: relative;
    overflow: hidden;
  }

  /* ── Background ── */
  .cta__bg { position: absolute; inset: 0; pointer-events: none; }

  .cta__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.12;
  }

  .cta__orb--1 {
    width: 500px;
    height: 500px;
    background: var(--color-primary);
    top: -200px;
    left: -200px;
  }

  .cta__orb--2 {
    width: 400px;
    height: 400px;
    background: #06b6d4;
    bottom: -150px;
    right: -100px;
  }

  /* ── Container ── */
  .cta__container {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 80px;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 32px;
    padding: 72px 80px;
    overflow: hidden;
  }

  /* ── Content ── */
  .cta__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: var(--color-primary);
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 28px;
  }

  .badge__dot {
    width: 7px;
    height: 7px;
    background: var(--color-primary);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  .cta__title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 20px;
  }

  .cta__title em {
    font-style: normal;
    background: linear-gradient(135deg, var(--color-primary), #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cta__text {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin: 0 0 36px;
    max-width: 500px;
  }
  /* ── Trust ── */
  .cta__trust {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .trust__item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .trust__icon {
    color: var(--color-primary);
    font-weight: 700;
  }

  /* ── Deco ── */
  .cta__deco {
    position: relative;
    width: 200px;
    height: 200px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .deco__ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(16, 185, 129, 0.15);
    animation: spin 20s linear infinite;
  }

  .deco__ring--1 { width: 100%; height: 100%; animation-duration: 20s; }
  .deco__ring--2 { width: 75%;  height: 75%;  animation-duration: 15s; animation-direction: reverse; }
  .deco__ring--3 { width: 50%;  height: 50%;  animation-duration: 10s; }

  .deco__center {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, var(--color-primary), #06b6d4);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.2rem;
    color: #020617;
    z-index: 2;
    position: relative;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(0.8); }
  }

  @media (max-width: 900px) {
    .cta__container {
      grid-template-columns: 1fr;
      padding: 48px 36px;
      gap: 48px;
    }
    .cta__deco { display: none; }
  }
</style>