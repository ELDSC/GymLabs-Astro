---
import Button from "../ui/Button.astro";
---

<section class="cta-section">
    <div class="cta-container">
        <div class="cta-content">
            <h2 class="cta-title">Transforma tu Entrenamiento</h2>
            <p class="cta-description">
                En GymLabs creemos que el fitness es más que ejercicio. Es un
                estilo de vida. Únete a nuestra comunidad y alcanza tus
                objetivos con tecnología de punta y entrenadores expertos.
            </p>

            <div class="cta-buttons">
                <Button
                    text="Comienza Ahora"
                    href="#ofertas"
                    variant="primary"
                />
                <Button
                    text="Más Información"
                    href="#categorias"
                    variant="secondary"
                />
            </div>
        </div>

        <div class="cta-image">
            <div class="image-placeholder">
                <img src="/gym-cta.jpg" alt="GymLabs CTA" />
            </div>
        </div>
    </div>
</section>

<style>
    .cta-section {
        background: var(--bg-base);
        padding: 3rem 1rem;
        margin: 2rem 0;
    }

    .cta-container {
        border: 1px red solid;
        padding: 20px;
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
    }

    .cta-content {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .cta-title {
        font-family: var(--font-primary);
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.2;
    }

    .cta-description {
        font-family: var(--font-primary);
        font-size: 1.1rem;
        color: var(--text-secondary);
        line-height: 1.6;
    }

    .cta-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .cta-image {
        position: relative;
        overflow: hidden;
        border-radius: 1rem;
        border: 2px solid var(--border-color);
    }

    .image-placeholder {
        width: 100%;
        aspect-ratio: 1;
        background: var(--bg-surface);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .image-placeholder img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .cta-image:hover img {
        transform: scale(1.05);
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .cta-container {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        .cta-buttons {
            flex-direction: column;
            max-width: 200px;
            margin: 0 auto;
            border: 1px red solid;
        }
        .cta-image {
            width: 90%;
            height: 90%;
            margin: 0 auto;
        }
    }
    @media (max-width: 768px) {
        .cta-container {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        .cta-buttons {
            flex-direction: column;
            max-width: 200px;
            margin: 0 auto;
            border: 1px red solid;
        }
        .btn {
            width: 100%;
            text-align: center;
        }

        .cta-section {
            padding: 2rem 1rem;
        }
    }
    @media (max-width: 425px) {
    }
    @media (max-width: 375px) {
    }
    @media (max-width: 320px) {
    }
</style>
