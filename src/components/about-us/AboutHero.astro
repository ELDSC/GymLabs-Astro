---
// AboutHero.astro
// Los datos de cada slide se definen aquí en el frontmatter (server-side)
const slides = [
  {
    badge: "Quiénes somos",
    title: "Más que una marca,",
    titleEm: "una comunidad",
    subtitle:
      "En GymLabs fusionamos ciencia, nutrición y tecnología para llevar tu rendimiento al siguiente nivel. Nacimos de la pasión y crecemos contigo.",
    stats: [
      { num: "5+",   label: "Años de experiencia" },
      { num: "10k+", label: "Atletas satisfechos" },
      { num: "50+",  label: "Productos premium" },
    ],
  },
  {
    badge: "Nuestra ciencia",
    title: "Respaldados por",
    titleEm: "la evidencia",
    subtitle:
      "Cada fórmula nace en el laboratorio y se valida en el campo. Trabajamos con nutricionistas, bioquímicos y atletas de élite para garantizar resultados reales.",
    stats: [
      { num: "30+",  label: "Expertos en el equipo" },
      { num: "200+", label: "Estudios revisados" },
      { num: "3",    label: "Laboratorios certificados" },
    ],
  },
  {
    badge: "Nuestros resultados",
    title: "Rendimiento real,",
    titleEm: "atletas reales",
    subtitle:
      "Miles de personas ya transformaron su entrenamiento con GymLabs. Desde el gimnasio amateur hasta la competencia profesional, estamos en cada etapa de tu camino.",
    stats: [
      { num: "95%",  label: "Tasa de satisfacción" },
      { num: "#1",   label: "En ventas en Perú" },
      { num: "8",    label: "Premios de industria" },
    ],
  },
];
---

<section class="hero">
  <!-- Background -->
  <div class="hero__bg">
    <div class="hero__orb hero__orb--1"></div>
    <div class="hero__orb hero__orb--2"></div>
    <div class="hero__grid"></div>
  </div>

  <!-- Slides -->
  <div class="hero__track" id="heroTrack">
    {slides.map((slide, i) => (
      <div class={`hero__slide ${i === 0 ? "is-active" : ""}`} data-index={i}>
        <div class="hero__content">
          <div class="hero__badge">
            <span class="badge__dot"></span>
            <span>{slide.badge}</span>
          </div>

          <h1 class="hero__title">
            {slide.title}<br />
            <em>{slide.titleEm}</em>
          </h1>

          <p class="hero__subtitle">{slide.subtitle}</p>

          <div class="hero__stats">
            {slide.stats.map((stat, si) => (
              <>
                <div class="stat">
                  <span class="stat__num">{stat.num}</span>
                  <span class="stat__label">{stat.label}</span>
                </div>
                {si < slide.stats.length - 1 && <div class="stat__divider" />}
              </>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Controls -->
  <div class="hero__controls">
    <button class="ctrl ctrl--prev" id="heroPrev" aria-label="Anterior">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>

    <div class="hero__dots" id="heroDots">
      {slides.map((_, i) => (
        <button
          class={`dot ${i === 0 ? "is-active" : ""}`}
          data-dot={i}
          aria-label={`Slide ${i + 1}`}
        />
      ))}
    </div>

    <button class="ctrl ctrl--next" id="heroNext" aria-label="Siguiente">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </button>
  </div>

  
</section>

<!-- =====================================================
     CLIENT-SIDE JS
     En Astro, la interactividad del browser va en <script>.
     El frontmatter (---) es solo para código server-side.
===================================================== -->
<script>
  const TOTAL    = 3;
  const INTERVAL = 5000; // ms entre slides automáticos

  let current  = 0;
  let timer: ReturnType<typeof setInterval>;

  const slides = document.querySelectorAll<HTMLElement>(".hero__slide");
  const dots   = document.querySelectorAll<HTMLButtonElement>("[data-dot]");
  const prev   = document.getElementById("heroPrev")!;
  const next   = document.getElementById("heroNext")!;

  function goTo(index: number): void {
    slides[current].classList.remove("is-active");
    dots[current].classList.remove("is-active");

    current = (index + TOTAL) % TOTAL;

    slides[current].classList.add("is-active");
    dots[current].classList.add("is-active");
  }

  function startAuto(): void {
    timer = setInterval(() => goTo(current + 1), INTERVAL);
  }

  function resetAuto(): void {
    clearInterval(timer);
    startAuto();
  }

  prev.addEventListener("click", () => { goTo(current - 1); resetAuto(); });
  next.addEventListener("click", () => { goTo(current + 1); resetAuto(); });

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      goTo(Number(dot.dataset.dot));
      resetAuto();
    });
  });

  // Swipe táctil
  let touchStartX = 0;
  const track = document.getElementById("heroTrack")!;

  track.addEventListener("touchstart", (e) => {
    touchStartX = e.touches[0].clientX;
  });

  track.addEventListener("touchend", (e) => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) {
      goTo(diff > 0 ? current + 1 : current - 1);
      resetAuto();
    }
  });

  startAuto();
</script>

<style>
  /* ── Base ── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 120px 24px 40px;
  }

  /* ── Background ── */
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.18;
  }

  .hero__orb--1 {
    width: 600px;
    height: 600px;
    background: var(--color-primary);
    top: -200px;
    left: -100px;
    animation: orbFloat 8s ease-in-out infinite;
  }

  .hero__orb--2 {
    width: 400px;
    height: 400px;
    background: #06b6d4;
    bottom: -100px;
    right: -100px;
    animation: orbFloat 10s ease-in-out infinite reverse;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(16, 185, 129, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(16, 185, 129, 0.04) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  /* ── Track & Slides ── */
  .hero__track {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    place-items: center;
  }

  .hero__slide {
    grid-area: 1 / 1;
    width: 100%;
    display: flex;
    justify-content: center;
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .hero__slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* ── Content ── */
  .hero__content {
    text-align: center;
    max-width: 780px;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: var(--color-primary);
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 32px;
  }

  .badge__dot {
    width: 7px;
    height: 7px;
    background: var(--color-primary);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  .hero__title {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 24px;
  }

  .hero__title em {
    font-style: normal;
    background: linear-gradient(135deg, var(--color-primary), #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 auto 56px;
    max-width: 580px;
  }

  /* ── Stats ── */
  .hero__stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat__num {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat__label {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .stat__divider {
    width: 1px;
    height: 48px;
    background: var(--border-color);
  }

  /* ── Controls ── */
  .hero__controls {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 48px;
  }

  .ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.08);
    color: var(--color-primary);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }

  .ctrl:hover {
    background: rgba(16, 185, 129, 0.2);
    border-color: rgba(16, 185, 129, 0.6);
  }

  .hero__dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: var(--border-color, rgba(255,255,255,0.2));
    cursor: pointer;
    transition: background 0.3s, transform 0.3s;
    padding: 0;
  }

  .dot.is-active {
    background: var(--color-primary);
    transform: scale(1.35);
  }

 


  /* ── Animations ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes orbFloat {
    0%, 100% { transform: translateY(0) scale(1); }
    50%       { transform: translateY(-300px) scale(1.05); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(0.8); }
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .hero__stats   { gap: 20px; flex-wrap: wrap; }
    .stat__num     { font-size: 1.8rem; }
    .stat__divider { height: 36px; display: none; }
    .hero__controls { margin-top: 32px; }
  }

</style>