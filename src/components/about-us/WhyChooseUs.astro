---
// WhyChooseUs.astro

const reasons = [
  {
    num: "01",
    icon: "🧪",
    title: "Fórmulas con respaldo científico",
    desc: "Cada dosis está diseñada en base a estudios clínicos. No seguimos modas, seguimos la evidencia.",
  },
  {
    num: "02",
    icon: "🏷️",
    title: "Transparencia total",
    desc: "Sin propietario blends, sin ingredientes ocultos. Sabes exactamente qué consumes y por qué.",
  },
  {
    num: "03",
    icon: "⚡",
    title: "Resultados reales",
    desc: "Miles de atletas han mejorado su rendimiento, recuperación y composición corporal con GymLabs.",
  },
  {
    num: "04",
    icon: "🔒",
    title: "Certificaciones de calidad",
    desc: "Nuestras instalaciones y productos cumplen con estándares internacionales de manufactura.",
  },
  {
    num: "05",
    icon: "📦",
    title: "Envío rápido y seguro",
    desc: "Tu pedido llega en perfectas condiciones. Entrega express disponible en toda la región.",
  },
  {
    num: "06",
    icon: "💬",
    title: "Soporte especializado",
    desc: "Nuestro equipo incluye nutricionistas y entrenadores que te asesoran sin costo adicional.",
  },
];
---

<section class="why">
  <div class="why__container">

    <div class="why__header">
      <div class="section-tag">Por qué elegirnos</div>
      <h2 class="why__title">La diferencia<br /><em>GymLabs</em></h2>
      <p class="why__lead">
        No somos otra marca de suplementos. Somos el resultado de años investigando
        qué funciona de verdad para el atleta latinoamericano.
      </p>
    </div>

    <div class="why__grid">
      {reasons.map((r, i) => (
        <div class="reason" style={`animation-delay: ${i * 0.07}s`}>
          <div class="reason__top">
            <span class="reason__num">{r.num}</span>
            <span class="reason__icon">{r.icon}</span>
          </div>
          <h3 class="reason__title">{r.title}</h3>
          <p class="reason__desc">{r.desc}</p>
          <div class="reason__line"></div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA strip -->
    <div class="why__strip">
      <p class="strip__text">Más de <strong>10,000 atletas</strong> ya confían en GymLabs</p>
      <a href="#team" class="strip__btn">Conoce al equipo →</a>
    </div>

  </div>
</section>

<style>
  .why {
    padding: 120px 24px;
    position: relative;
  }

  .why__container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  /* ── Header ── */
  .why__header { text-align: center; }

  .section-tag {
    display: inline-block;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 20px;
  }

  .why__title {
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 20px;
  }

  .why__title em {
    font-style: normal;
    background: linear-gradient(135deg, var(--color-primary), #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .why__lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 560px;
    margin: 0 auto;
  }

  /* ── Grid ── */
  .why__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--border-color);
    border-radius: 24px;
    overflow: hidden;
  }

  .reason {
    background: var(--bg-surface);
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    transition: background 0.3s;
    animation: fadeUp 0.5s ease both;
  }

  .reason:hover {
    background: var(--bg-surface-2);
  }

  .reason__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .reason__num {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: 0.08em;
  }

  .reason__icon { font-size: 1.6rem; }

  .reason__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .reason__desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .reason__line {
    position: absolute;
    bottom: 0;
    left: 36px;
    right: 36px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-primary), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .reason:hover .reason__line { opacity: 1; }

  /* ── Strip ── */
  .why__strip {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 32px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .strip__text {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .strip__text strong {
    color: var(--color-primary);
    font-weight: 700;
  }

  .strip__btn {
    background: var(--color-primary);
    color: #020617;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 12px 28px;
    border-radius: 10px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s, transform 0.2s;
  }

  .strip__btn:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 900px) {
    .why__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .why__grid { grid-template-columns: 1fr; }
    .why__strip { flex-direction: column; text-align: center; }
  }
</style>