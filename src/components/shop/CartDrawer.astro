---

---

<div id="cart-drawer-overlay" class="cart-overlay"></div>

<div id="cart-drawer" class="cart-drawer">
  <div class="cart-header">
    <h2>Tu Carrito</h2>
    <button id="close-cart-btn" class="close-btn">&times;</button>
  </div>

  <div class="cart-body">
    <div id="cart-items-container" class="cart-items">
      <!-- Los ítems del carrito se renderizan aquí dinámicamente -->
    </div>

    <div class="cart-summary">
      <div class="summary-row">
        <span>Subtotal</span>
        <span id="cart-subtotal">S/ 0.00</span>
      </div>
      <div class="discount-section">
        <input
          type="text"
          id="discount-code-input"
          placeholder="Código de descuento"
        />
        <button id="apply-discount-btn" type="button">Aplicar</button>
      </div>
      <div id="discount-message" class="discount-message"></div>
      <div
        class="summary-row discount-row"
        id="discount-row"
        style="display: none;"
      >
        <span>Descuento</span>
        <span id="cart-discount">- S/ 0.00</span>
      </div>
      <div class="summary-row total-row">
        <span>Total</span>
        <span id="cart-total">S/ 0.00</span>
      </div>
    </div>

    <div class="checkout-section">
      <h3>Datos de compra</h3>
      <form id="checkout-form">
        <div class="form-group">
          <label for="checkout-name">Nombres completos</label>
          <input type="text" id="checkout-name" required />
        </div>
        <div class="form-group">
          <label for="checkout-age">Edad</label>
          <input type="number" id="checkout-age" min="1" required />
        </div>
        <div class="form-group">
          <label for="checkout-sex">Sexo</label>
          <select id="checkout-sex" required>
            <option value="">Selecciona...</option>
            <option value="M">Masculino</option>
            <option value="F">Femenino</option>
            <option value="O">Otro</option>
          </select>
        </div>
        <button type="submit" class="btn-checkout" id="btn-checkout"
          >Comprar</button
        >
      </form>
    </div>
  </div>
</div>

<div id="thank-you-modal" class="thank-you-modal">
  <div class="modal-content">
    <h2>Pedido Procesado</h2>
    <p>
      Tu compra se ha registrado exitosamente. Prepárate para llevar tu
      rendimiento al siguiente nivel.
    </p>
    <button id="close-thank-you-btn" class="btn-checkout">Cerrar</button>
  </div>
</div>

<style is:global>
  .cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 2000;
  }
  .cart-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 400px;
    max-width: 100vw;
    background: var(--bg-surface, #0f172a);
    box-shadow: -4px 0 15px rgba(0, 0, 0, 0.5);
    z-index: 2001;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    font-family: var(--font-primary);
    color: var(--text-primary);
  }
  .cart-drawer.open {
    transform: translateX(0);
  }

  .cart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color, #1e293b);
  }
  .cart-header h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  .close-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
  }
  .close-btn:hover {
    color: var(--text-primary);
  }

  .cart-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .cart-items {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Se generará dinámicamente en JS */
  .cart-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .cart-item img {
    width: 60px;
    height: 60px;
    min-width: 60px;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--border-color, #1e293b);
  }
  .cart-item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .cart-item-name {
    font-weight: 500;
    font-size: 0.95rem;
    margin: 0;
    color: var(--text-primary);
  }
  .cart-item-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.25rem;
  }
  .price {
    font-weight: 600;
    color: var(--color-primary);
  }
  .qty-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg-base, #020617);
    padding: 2px 4px;
    border-radius: 4px;
    border: 1px solid var(--border-color, #1e293b);
  }
  .qty-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    transition: color 0.2s;
  }
  .qty-btn:hover {
    color: var(--text-primary);
  }

  .cart-summary {
    background: var(--bg-base, #020617);
    padding: 1.25rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
  }
  .discount-row {
    color: var(--color-primary, #10b981);
  }
  .total-row {
    font-weight: 800;
    font-size: 1.15rem;
    border-top: 1px solid var(--border-color, #1e293b);
    padding-top: 0.75rem;
    margin-top: 0.5rem;
  }

  .discount-section {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .discount-section input {
    flex: 1;
    background: var(--bg-surface, #0f172a);
    border: 1px solid var(--border-color, #1e293b);
    color: white;
    padding: 0.5rem;
    border-radius: 6px;
    outline: none;
  }
  .discount-section button {
    background: var(--border-color, #1e293b);
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
  }
  .discount-section button:hover {
    background: var(--color-primary, #10b981);
  }
  .discount-message {
    font-size: 0.85rem;
    margin-top: -0.25rem;
  }
  .discount-message.error {
    color: #ef4444;
  }
  .discount-message.success {
    color: var(--color-primary, #10b981);
  }

  .checkout-section h3 {
    margin: 0 0 1.25rem 0;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  .form-group {
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .form-group label {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .form-group input,
  .form-group select {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid var(--border-color, #1e293b);
    color: var(--text-primary);
    padding: 0.5rem 0;
    outline: none;
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 0.2s;
  }

  /* Forzar fondo oscuro para el desplegable (select) en todos los navegadores */
  .form-group select {
    background-color: var(--bg-surface, #0f172a);
    color: white;
  }
  .form-group select option {
    background-color: var(--bg-surface, #0f172a);
    color: white;
  }
  .form-group input:focus,
  .form-group select:focus {
    border-bottom-color: var(--color-primary, #10b981);
  }

  .btn-checkout {
    width: 100%;
    background-color: var(--color-primary, #10b981);
    color: var(--bg-base, #020617);
    border: none;
    padding: 14px;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    margin-top: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  .btn-checkout::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2),
      transparent
    );
    transform: translateX(-100%);
    transition: transform 0.5s ease;
  }
  .btn-checkout:hover:not(:disabled) {
    background-color: #059669; /* Un verde un poco más oscuro al pasar el mouse */
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
  }
  .btn-checkout:hover:not(:disabled)::after {
    transform: translateX(100%);
  }
  .btn-checkout:disabled {
    background-color: var(--bg-surface-2, #1e293b);
    color: var(--text-muted);
    cursor: not-allowed;
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .empty-state p {
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }
  .btn-continue {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 8px 16px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s;
  }
  .btn-continue:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Modal */
  .thank-you-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .thank-you-modal.open {
    opacity: 1;
    pointer-events: auto;
  }
  .thank-you-modal .modal-content {
    background: linear-gradient(135deg, var(--color-primary, #10b981), #059669);
    padding: 3rem 2rem;
    border-radius: 12px;
    max-width: 400px;
    width: 90%;
    text-align: center;
    color: var(--bg-base, #020617);
    box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4);
  }
  .thank-you-modal h2 {
    margin: 0 0 1rem 0;
    font-size: 1.5rem;
    color: var(--bg-base, #020617);
  }
  .thank-you-modal p {
    margin: 0 0 1.5rem 0;
    color: rgba(2, 6, 23, 0.85);
    font-size: 1rem;
    line-height: 1.5;
  }
  .thank-you-modal .btn-checkout {
    background: var(--bg-base, #020617);
    color: var(--text-primary, white);
  }
  .thank-you-modal .btn-checkout:hover {
    background: #1e293b;
    box-shadow: none;
  }
</style>

<script>
  import {
    getCart,
    removeFromCart,
    updateQuantity,
    clearCart,
  } from "../../lib/cart";

  const drawer = document.getElementById("cart-drawer");
  const overlay = document.getElementById("cart-drawer-overlay");
  const closeBtn = document.getElementById("close-cart-btn");
  const container = document.getElementById("cart-items-container");
  const subtotalEl = document.getElementById("cart-subtotal");
  const totalEl = document.getElementById("cart-total");
  const discountRow = document.getElementById("discount-row");
  const discountAmountEl = document.getElementById("cart-discount");
  const discountInput = document.getElementById(
    "discount-code-input",
  ) as HTMLInputElement;
  const applyDiscountBtn = document.getElementById("apply-discount-btn");
  const discountMsg = document.getElementById("discount-message");

  const checkoutForm = document.getElementById(
    "checkout-form",
  ) as HTMLFormElement;
  const checkoutBtn = document.getElementById(
    "btn-checkout",
  ) as HTMLButtonElement;
  const thankYouModal = document.getElementById("thank-you-modal");
  const closeThankYouBtn = document.getElementById("close-thank-you-btn");

  let currentSubtotal = 0;
  let currentDiscountPercentage = 0;
  let currentDiscountCode = "";
  let currentDiscountAmount = 0;
  let currentTotal = 0;

  function formatPrice(val: number) {
    return new Intl.NumberFormat("es-PE", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(val);
  }

  function renderCart() {
    const cart = getCart();
    if (!container) return;

    container.innerHTML = "";

    if (cart.length === 0) {
      container.innerHTML = `
        <div class="empty-state">
          <p>Aún no has seleccionado productos. Explora nuestra tienda para mejorar tu rendimiento.</p>
          <button class="btn-continue" onclick="document.getElementById('close-cart-btn').click()">Cerrar y explorar</button>
        </div>
      `;
      checkoutBtn.disabled = true;
      checkoutBtn.textContent = "Procesar pedido";
    } else {
      checkoutBtn.disabled = false;
      cart.forEach((item) => {
        const div = document.createElement("div");
        div.className = "cart-item";
        div.innerHTML = `
          <img src="${item.image}" alt="${item.name}" style="width: 60px; height: 60px; min-width: 60px; object-fit: cover; border-radius: 6px;">
          <div class="cart-item-details">
            <h4 class="cart-item-name">${item.name}</h4>
            <div class="cart-item-controls">
              <span class="price">S/ ${formatPrice(item.price * item.quantity)}</span>
              <div class="qty-controls">
                <button class="qty-btn dec-btn" data-id="${item.id}">-</button>
                <span>${item.quantity}</span>
                <button class="qty-btn inc-btn" data-id="${item.id}">+</button>
              </div>
            </div>
          </div>
        `;
        container.appendChild(div);
      });
    }

    currentSubtotal = cart.reduce(
      (sum, item) => sum + item.price * item.quantity,
      0,
    );

    if (subtotalEl)
      subtotalEl.textContent = `S/ ${formatPrice(currentSubtotal)}`;

    recalculateTotals();

    // Attach events to dynamic buttons
    document.querySelectorAll(".dec-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (id) {
          const item = getCart().find((i) => i.id === id);
          if (item) updateQuantity(id, item.quantity - 1);
        }
      });
    });

    document.querySelectorAll(".inc-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (id) {
          const item = getCart().find((i) => i.id === id);
          if (item) updateQuantity(id, item.quantity + 1);
        }
      });
    });
  }

  function recalculateTotals() {
    currentDiscountAmount = (currentSubtotal * currentDiscountPercentage) / 100;
    currentTotal = currentSubtotal - currentDiscountAmount;

    if (currentDiscountPercentage > 0 && discountRow && discountAmountEl) {
      discountRow.style.display = "flex";
      discountAmountEl.textContent = `- S/ ${formatPrice(currentDiscountAmount)}`;
    } else if (discountRow) {
      discountRow.style.display = "none";
    }

    if (totalEl) totalEl.textContent = `S/ ${formatPrice(currentTotal)}`;
  }

  function openCart() {
    drawer?.classList.add("open");
    overlay?.classList.add("open");
    renderCart();
  }

  function closeCart() {
    drawer?.classList.remove("open");
    overlay?.classList.remove("open");
  }

  closeBtn?.addEventListener("click", closeCart);
  overlay?.addEventListener("click", closeCart);

  // Listen for open events
  window.addEventListener("open-cart", openCart);
  window.addEventListener("cart-updated", renderCart);

  // Initial render if open
  renderCart();

  // Discount Logic
  applyDiscountBtn?.addEventListener("click", async () => {
    const code = discountInput.value.trim().toUpperCase();
    if (!code) return;

    if (currentSubtotal === 0) {
      if (discountMsg) {
        discountMsg.textContent =
          "Agrega productos antes de aplicar un descuento.";
        discountMsg.className = "discount-message error";
      }
      return;
    }

    try {
      const res = await fetch("/api/discount-codes/validate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ code, subtotal: currentSubtotal }),
      });

      const data = await res.json();

      if (res.ok && data.percentage) {
        currentDiscountPercentage = data.percentage;
        currentDiscountCode = data.code;
        if (discountMsg) {
          discountMsg.textContent = `Descuento ${data.percentage}% aplicado.`;
          discountMsg.className = "discount-message success";
        }
        recalculateTotals();
      } else {
        currentDiscountPercentage = 0;
        currentDiscountCode = "";
        if (discountMsg) {
          discountMsg.textContent = data.error || "Código inválido.";
          discountMsg.className = "discount-message error";
        }
        recalculateTotals();
      }
    } catch (e) {
      if (discountMsg) {
        discountMsg.textContent = "Error al validar el código.";
        discountMsg.className = "discount-message error";
      }
    }
  });

  // Checkout Logic
  checkoutForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const name = (document.getElementById("checkout-name") as HTMLInputElement)
      .value;
    const age = parseInt(
      (document.getElementById("checkout-age") as HTMLInputElement).value,
      10,
    );
    const sex = (document.getElementById("checkout-sex") as HTMLSelectElement)
      .value;
    const cart = getCart();

    if (cart.length === 0 || age <= 0 || !name || !sex) return;

    checkoutBtn.disabled = true;
    checkoutBtn.textContent = "Procesando...";

    try {
      const res = await fetch("/api/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          fullName: name,
          age,
          sex,
          items: cart,
          discountCode: currentDiscountCode || null,
        }),
      });

      if (res.ok) {
        closeCart();
        clearCart();
        checkoutForm.reset();
        currentDiscountCode = "";
        currentDiscountPercentage = 0;
        if (discountMsg) discountMsg.textContent = "";
        if (discountInput) discountInput.value = "";

        thankYouModal?.classList.add("open");
      } else {
        alert("Ocurrió un error al procesar tu compra.");
      }
    } catch (e) {
      alert("Error de conexión.");
    } finally {
      checkoutBtn.disabled = false;
      checkoutBtn.textContent = "Procesar pedido";
    }
  });

  closeThankYouBtn?.addEventListener("click", () => {
    thankYouModal?.classList.remove("open");
  });
</script>
