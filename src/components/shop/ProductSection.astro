---
import ProductCard from "../ui/ProductCard.astro";
import SibarCategory from "./SibarCategory.astro";

interface ProductItem {
  id: string;
  name: string;
  category: string;
  imageUrl: string;
  price: number;
  compareAtPrice?: number | null;
  badge?: string;
}

interface CategoryItem {
  id: string;
  name: string;
  slug: string;
}

interface Filters {
  search: string;
  categorySlug: string;
  activeCategoryName: string;
  minPrice: string;
  maxPrice: string;
}

interface Props {
  products: ProductItem[];
  categories: CategoryItem[];
  filters: Filters;
}

const { products, categories, filters } = Astro.props;
---

<div class="container">
  <SibarCategory categories={categories} filters={filters} />

  <section class="section" id="products-section">
    {products.length === 0 ? (
      <div class="empty-state">
        <p>No se encontraron productos con los filtros seleccionados.</p>
        <a href="/shop" class="btn-clear-filters">Limpiar filtros</a>
      </div>
    ) : (
      <div class="products-grid">
        {products.map((product) => <ProductCard {...product} />)}
      </div>
    )}
  </section>
</div>

<style>
  .container {
    display: flex;
    gap: 2rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .section {
    flex: 1;
    padding-block: 1.5rem;
  }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-muted);
  }
  .empty-state p {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }
  .btn-clear-filters {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 999px;
    border: 1px solid var(--color-primary);
    background: transparent;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    transition: 0.3s;
  }
  .btn-clear-filters:hover {
    background: var(--color-primary);
    color: var(--bg-base);
  }
  @media (max-width: 900px) {
    .container { flex-direction: column; }
  }
  @media (max-width: 768px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  }
  @media (max-width: 480px) {
    .products-grid { grid-template-columns: 1fr; }
  }
</style>
