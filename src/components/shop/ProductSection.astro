---
import ProductCard from "../ui/ProductCard.astro";

interface ProductItem {
  id: string;
  name: string;
  category: string;
  imageUrl: string;
  price: number;
  compareAtPrice?: number | null;
  badge?: string;
}

interface Props {
  title?: string;
  products: ProductItem[];
}

const { title = "Ofertas destacadas", products } = Astro.props;
---

<section class="section" id="products-section" aria-labelledby="products-title">
  <div class="section__inner">
    <div class="section__heading">
      <h2 id="products-title">{title}</h2>
    </div>

    <div class="products-grid">
      {products.map((product) => <ProductCard {...product} />)}
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: clamp(3rem, 5vw, 4rem);
    margin-inline: auto;
  }

  .section__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .section__heading {
    margin-bottom: 2rem;
    text-align: center;
  }

  .section__heading h2 {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .products-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
