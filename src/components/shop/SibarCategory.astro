---
interface CategoryItem {
  id: string;
  name: string;
  slug: string;
}

interface Filters {
  search: string;
  categorySlug: string;
  activeCategoryName: string;
  minPrice: string;
  maxPrice: string;
}

interface Props {
  categories: CategoryItem[];
  filters: Filters;
}

const { categories, filters } = Astro.props;
const { search, categorySlug, maxPrice } = filters;

// Emojis removed in favor of clean typography
function buildUrl(params: Record<string, string>) {
  const sp = new URLSearchParams();
  Object.entries(params).forEach(([key, value]) => {
    if (value) sp.set(key, value);
  });
  const qs = sp.toString();
  return `/shop${qs ? "?" + qs : ""}`;
}
---

<aside class="sidebar">
  <button
    class="sidebar-close"
    id="sidebar-close"
    type="button"
    aria-label="Cerrar filtros"
  >
    <span aria-hidden="true">&times;</span>
  </button>

  <h2 class="logo">GymLabs</h2>

  <div class="section">
    <p class="section-title">CATEGORIAS</p>
    <span class="subtitle">Refina tu rendimiento</span>

    <ul class="menu">
      <li>
        <a
          href={buildUrl({ search, minPrice: filters.minPrice, maxPrice })}
          class={`item ${!categorySlug ? "active" : ""}`}
        >
          Todos
        </a>
      </li>
      {
        categories.map((cat) => (
          <li>
            <a
              href={buildUrl({
                category: cat.slug,
                search,
                minPrice: filters.minPrice,
                maxPrice,
              })}
              class={`item ${categorySlug === cat.slug ? "active" : ""}`}
            >
              {cat.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="section">
    <p class="section-title">RANGO DE PRECIO</p>
    <input
      type="range"
      id="price-range"
      class="range"
      min="0"
      max="100"
      value={maxPrice || "100"}
    />
    <div class="range-values">
      <span>S/ 0</span>
      <span id="price-label">S/ {maxPrice || "100"}</span>
    </div>
  </div>

  <a href="/shop" class="btn-clear" role="button"> Borrar filtros </a>
</aside>

<script>
  const slider = document.getElementById("price-range") as HTMLInputElement;
  const label = document.getElementById("price-label");

  if (slider) {
    slider.addEventListener("input", () => {
      if (label) label.textContent = `S/ ${slider.value}`;
    });

    slider.addEventListener("change", () => {
      const params = new URLSearchParams(window.location.search);
      if (slider.value && slider.value !== "100") {
        params.set("maxPrice", slider.value);
      } else {
        params.delete("maxPrice");
      }
      const qs = params.toString();
      window.location.href = `/shop${qs ? "?" + qs : ""}`;
    });
  }
</script>

<style>
  .sidebar {
    width: 260px;
    flex-shrink: 0;
    position: sticky;
    top: 80px;
    align-self: flex-start;
    background: var(--bg-surface, #0f172a);
    padding: 24px;
    border-radius: 12px;
    border: 1px solid var(--border-color, #1e293b);
  }
  .logo {
    color: var(--color-primary);
    font-size: 1.5rem;
    font-weight: bold;
  }
  .section-title {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
  }
  .subtitle {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0;
  }
  .menu {
    list-style: none;
    padding: 0;
    margin-top: 10px;
  }
  .item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 6px;
    cursor: pointer;
    color: var(--text-secondary);
    transition: all 0.2s ease;
    text-decoration: none;
    font-size: 0.95rem;
    border-left: 2px solid transparent;
  }
  .item:hover {
    color: var(--text-primary);
  }
  .item.active {
    background: rgba(16, 185, 129, 0.05); /* Subtle primary tint */
    border-left: 2px solid var(--color-primary);
    color: var(--text-primary);
    font-weight: 600;
  }
  .range {
    width: 100%;
    margin-top: 10px;
    accent-color: var(--color-primary);
  }
  .range-values {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .btn-clear {
    display: block;
    margin-top: 24px;
    padding: 10px;
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }
  .btn-clear:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .sidebar-close {
    display: none;
  }

  @media (max-width: 900px) {
    .sidebar-close {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 12px;
      right: 12px;
      width: 32px;
      height: 32px;
      border: none;
      border-radius: 8px;
      background: var(--bg-surface-2);
      color: var(--text-secondary);
      font-size: 1.3rem;
      cursor: pointer;
      line-height: 1;
      transition: background 0.2s;
    }
    .sidebar-close:hover {
      background: var(--border-color);
      color: var(--text-primary);
    }
  }
</style>
