<style is:global>
  .table-shell {
    overflow: hidden;
    border: 1px solid #d8e0ea;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.06);
  }

  .table-head,
  .table-row {
    display: grid;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
  }

  .products-head,
  .products-row {
    grid-template-columns: minmax(260px, 1fr) 120px 110px 82px;
  }

  .categories-head,
  .categories-row,
  .discounts-head,
  .discounts-row {
    grid-template-columns: minmax(220px, 1fr) 110px 110px 82px;
  }

  .table-head {
    color: #475569;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #f8fafc;
    border-bottom: 1px solid #d9e2ec;
  }

  .table-row {
    min-height: 64px;
    border-bottom: 1px solid #e2e8f0;
  }

  .table-row:last-child {
    border-bottom: 0;
  }

  .item-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .item-title img {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: cover;
    background: #e2e8f0;
    flex: 0 0 auto;
  }

  .item-title strong,
  .code {
    display: block;
    color: #0f172a;
    font-weight: 800;
    word-break: break-word;
  }

  .item-title small {
    display: block;
    margin-top: 0.2rem;
    color: #64748b;
  }

  .status,
  .edit-chip {
    width: fit-content;
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .status.is-live {
    color: #0d5c3a;
    background: #eaf8f1;
  }

  .status.is-muted {
    color: #475569;
    background: #e2e8f0;
  }

  .edit-chip {
    border: 1px solid #d0d7e2;
    background: #fff;
    color: #0f172a;
    cursor: pointer;
    font: inherit;
  }

  .empty-state {
    margin: 0;
    padding: 1.5rem;
    color: #64748b;
  }

  @media (max-width: 920px) {
    .table-head {
      display: none;
    }

    .products-row,
    .categories-row,
    .discounts-row {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }
  }
</style>
