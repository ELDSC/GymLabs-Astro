<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

<script>
  function destroyExistingCharts() {
    const canvases = ["reports-bar-chart", "reports-pie-chart", "reports-line-chart"];
    canvases.forEach((id) => {
      const canvas = document.getElementById(id);
      if (!canvas || !window.Chart) return;
      const existing = window.Chart.getChart(canvas);
      if (existing) existing.destroy();
    });
  }

  function initReportsCharts() {
    const rawData = document.getElementById("reports-data");
    if (!rawData || !window.Chart) return;

    const data = JSON.parse(rawData.textContent || "{}");
    const Chart = window.Chart;

    destroyExistingCharts();

    const barCanvas = document.getElementById("reports-bar-chart");
    if (barCanvas) {
      new Chart(barCanvas, {
        type: "bar",
        data: {
          labels: (data.topProductsByUnits || []).map((p) => p.name),
          datasets: [
            {
              label: "Unidades vendidas",
              data: (data.topProductsByUnits || []).map((p) => p.unitsSold),
              backgroundColor: "#4f46e5",
              borderRadius: 6,
            },
          ],
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } },
        },
      });
    }

    const pieCanvas = document.getElementById("reports-pie-chart");
    if (pieCanvas) {
      new Chart(pieCanvas, {
        type: "pie",
        data: {
          labels: (data.topProductsByRevenue || []).map((p) => p.name),
          datasets: [
            {
              data: (data.topProductsByRevenue || []).map((p) => p.revenue),
              backgroundColor: [
                "#4f46e5",
                "#6366f1",
                "#818cf8",
                "#a5b4fc",
                "#c7d2fe",
                "#e0e7ff",
              ],
            },
          ],
        },
        options: {
          responsive: true,
          plugins: { legend: { position: "bottom" } },
        },
      });
    }

    const lineCanvas = document.getElementById("reports-line-chart");
    if (lineCanvas) {
      new Chart(lineCanvas, {
        type: "line",
        data: {
          labels: (data.dailySales || []).map((d) => d.date),
          datasets: [
            {
              label: "Ingresos por día",
              data: (data.dailySales || []).map((d) => d.total),
              borderColor: "#4f46e5",
              backgroundColor: "rgba(79, 70, 229, 0.15)",
              tension: 0.3,
              fill: true,
            },
          ],
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } },
        },
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initReportsCharts);
  document.addEventListener("astro:page-load", initReportsCharts);
</script>
