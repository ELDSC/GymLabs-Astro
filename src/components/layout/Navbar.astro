---
import icon from "../../assets/icon.jpeg";
const currentPath = Astro.url.pathname;
const currentSearch = Astro.url.searchParams.get("search") || "";
const currentCategory = Astro.url.searchParams.get("category") || "";
const currentMinPrice = Astro.url.searchParams.get("minPrice") || "";
const currentMaxPrice = Astro.url.searchParams.get("maxPrice") || "";
---

<nav class="navbar" aria-label="Navegación principal">
  <div class="nav-container">
    <a href="/" class="logo">
      <img src={icon.src} alt="Icon" width="20px" height="20px" />
      Gym
      <span>Labs</span>
    </a>
    <div class="opt">
      {
        currentPath === "/shop" && (
          <form action="/shop" method="GET" class="search-form">
            {currentCategory && <input type="hidden" name="category" value={currentCategory} />}
            {currentMinPrice && <input type="hidden" name="minPrice" value={currentMinPrice} />}
            {currentMaxPrice && <input type="hidden" name="maxPrice" value={currentMaxPrice} />}
            <input
              type="text"
              name="search"
              placeholder="Buscar productos..."
              class="input-search"
              value={currentSearch}
            />
          </form>
        )
      }
    </div>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/shop">Tienda</a></li>
      <li><a href="/ofertas">Ofertas</a></li>
      <li><a href="/about-us">Sobre Nosotros</a></li>
      <li><a href="/contacto">Contacto</a></li>
    </ul>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(12px);
    background-color: rgba(2, 6, 23, 0.78);
    border-bottom: 1px solid rgba(148, 163, 184, 0.1);
    font-family: var(--font-primary);
    color: var(--text-primary);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }

  .logo {
    color: var(--text-primary);
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: -0.04em;
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .logo span {
    color: var(--color-primary);
  }

  .logo img {
    margin-right: 10px;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 1rem;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .nav-links a:hover {
    color: var(--color-primary);
  }

  .search-form {
    display: flex;
  }

  .opt input {
    padding: 6px 10px;
    border-radius: 8px;
    border: none;
    outline: none;
    width: 250px;
  }

  @media (max-width: 980px) {
    .nav-container {
      flex-direction: column;
    }
  }

  @media (max-width: 600px) {
    .navbar {
      position: static;
    }
  }
</style>
