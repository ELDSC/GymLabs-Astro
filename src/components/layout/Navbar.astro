---
import icon from "../../assets/icon.jpeg";
const currentPath = Astro.url.pathname;
const currentSearch = Astro.url.searchParams.get("search") || "";
const currentCategory = Astro.url.searchParams.get("category") || "";
const currentMinPrice = Astro.url.searchParams.get("minPrice") || "";
const currentMaxPrice = Astro.url.searchParams.get("maxPrice") || "";
---

<nav class="navbar" aria-label="Navegación principal">
  <div class="nav-container">
    <a href="/" class="logo">
      <img src={icon.src} alt="Icon" width="20px" height="20px" />
      Gym
      <span>Labs</span>
    </a>
    <div class="opt">
      {
        currentPath === "/shop" && (
          <form action="/shop" method="GET" class="search-form">
            {currentCategory && <input type="hidden" name="category" value={currentCategory} />}
            {currentMinPrice && <input type="hidden" name="minPrice" value={currentMinPrice} />}
            {currentMaxPrice && <input type="hidden" name="maxPrice" value={currentMaxPrice} />}
            <input
              type="text"
              name="search"
              placeholder="Buscar productos..."
              class="input-search"
              value={currentSearch}
            />
          </form>
        )
      }
    </div>
    <div class="nav-right">
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/shop">Tienda</a></li>
        <li><a href="/about-us">Sobre Nosotros</a></li>
      </ul>
      {
        currentPath === "/shop" && (
          <button class="cart-btn" id="navbar-cart-btn" aria-label="Abrir carrito">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <span class="cart-badge" id="navbar-cart-badge" style="display: none;">0</span>
          </button>
        )
      }
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(12px);
    background-color: rgba(2, 6, 23, 0.78);
    border-bottom: 1px solid rgba(148, 163, 184, 0.1);
    font-family: var(--font-primary);
    color: var(--text-primary);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }

  .logo {
    color: var(--text-primary);
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: -0.04em;
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .logo span {
    color: var(--color-primary);
  }

  .logo img {
    margin-right: 10px;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 1rem;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .cart-btn {
    background: transparent;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    position: relative;
    display: flex;
    align-items: center;
    padding: 0;
    transition: color 0.3s;
  }

  .cart-btn:hover {
    color: var(--color-primary, #10b981);
  }

  .cart-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    background: var(--color-primary, #10b981);
    color: var(--bg-base, #020617);
    font-size: 0.7rem;
    font-weight: 800;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .nav-links a:hover {
    color: var(--color-primary);
  }

  .search-form {
    display: flex;
  }

  .opt input {
    padding: 6px 10px;
    border-radius: 8px;
    border: none;
    outline: none;
    width: 250px;
  }

  @media (max-width: 980px) {
    .nav-container {
      flex-direction: column;
    }
  }

  @media (max-width: 600px) {
    .navbar {
      position: static;
    }
  }
</style>

<script>
  import { getCart } from "../../lib/cart";

  const cartBtn = document.getElementById("navbar-cart-btn");
  const cartBadge = document.getElementById("navbar-cart-badge");

  function updateBadge() {
    if (!cartBadge) return;
    const cart = getCart();
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    
    if (totalItems > 0) {
      cartBadge.style.display = "flex";
      cartBadge.textContent = totalItems.toString();
    } else {
      cartBadge.style.display = "none";
    }
  }

  cartBtn?.addEventListener("click", () => {
    window.dispatchEvent(new Event("open-cart"));
  });

  window.addEventListener("cart-updated", updateBadge);
  
  // Initial check
  updateBadge();
</script>
