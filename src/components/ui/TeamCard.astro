---
const { member } = Astro.props;
---

<article class="card" data-id={member.id}>
  <!-- ── Foto ── -->
  <div class="card__visual">
    {member.photo_url
      ? <img src={member.photo_url} alt={`Foto de ${member.name}`} class="card__photo" />
      : <div class="card__avatar"><span>{member.name.charAt(0)}</span></div>
    }
    <div class="card__overlay"></div>
    <span class="card__role-badge">{member.role}</span>
  </div>

  <!-- ── Info base ── -->
  <div class="card__body">
    <h3 class="card__name">{member.name}</h3>
    <p class="card__desc">{member.description}</p>

    <!-- Skills rápidos -->
    <div class="card__skills">
      {member.cv.technical_skills.slice(0, 1).map((g: any) =>
        g.items.slice(0, 3).map((skill: string) => (
          <span class="skill-chip">{skill}</span>
        ))
      )}
    </div>

    <!-- Links sociales -->
    <div class="card__links">
      {member.linkedin && (
        <a href={member.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="social-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
          <span>LinkedIn</span>
        </a>
      )}
      {member.github && (
        <a href={member.github} target="_blank" rel="noopener" aria-label="GitHub" class="social-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          <span>GitHub</span>
        </a>
      )}
      {member.email && (
        <a href={`mailto:${member.email}`} aria-label="Email" class="social-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span>Email</span>
        </a>
      )}
    </div>

    <!-- Botón abrir CV modal -->
    <button class="card__cv-btn" data-open-cv={member.id}>
      <span>Ver CV completo</span>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
        <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <!-- ── Botón PDF — justo debajo del card ── -->
  <a
    class="card__pdf-btn"
    href={member.cv_pdf}
    target="_blank"
    rel="noopener"
    aria-label={`Ver CV de ${member.name} en PDF`}
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
      <polyline points="14 2 14 8 20 8"/>
      <line x1="12" y1="18" x2="12" y2="12"/>
      <line x1="9" y1="15" x2="15" y2="15"/>
    </svg>
    <span>Mostrar CV</span>
  </a>
</article>

<!-- ══════════════════════════════════════
     MODAL CV — individual por integrante
══════════════════════════════════════ -->
<div class="cv-modal" id={`cv-${member.id}`} role="dialog" aria-modal="true">
  <div class="cv-modal__backdrop" data-close-cv={member.id}></div>
  <div class="cv-modal__panel">

    <button class="cv-modal__close" data-close-cv={member.id} aria-label="Cerrar">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Header -->
    <div class="cv-header">
      <div class="cv-header__photo">
        {member.photo_url
          ? <img src={member.photo_url} alt={member.name} />
          : <span>{member.name.charAt(0)}</span>
        }
      </div>
      <div class="cv-header__info">
        <h2>{member.name}</h2>
        <span class="cv-role">{member.role}</span>
        <div class="cv-socials">
          {member.linkedin && <a href={member.linkedin} target="_blank">LinkedIn ↗</a>}
          {member.github   && <a href={member.github}   target="_blank">GitHub ↗</a>}
          {member.email    && <a href={`mailto:${member.email}`}>Email ↗</a>}
        </div>
      </div>
    </div>

    <!-- Objetivo -->
    {member.cv.objective && (
      <div class="cv-block">
        <h4 class="cv-block__title">Objetivo profesional</h4>
        <p class="cv-block__text">{member.cv.objective}</p>
      </div>
    )}

    <!-- Habilidades técnicas -->
    {member.cv.technical_skills?.length > 0 && (
      <div class="cv-block">
        <h4 class="cv-block__title">Habilidades técnicas</h4>
        {member.cv.technical_skills.map((g: any) => (
          <div class="cv-skill-row">
            <span class="cv-skill-row__label">{g.category}</span>
            <div class="cv-skill-row__tags">
              {g.items.map((item: string) => <span class="skill-tag">{item}</span>)}
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Habilidades blandas -->
    {member.cv.soft_skills?.length > 0 && (
      <div class="cv-block">
        <h4 class="cv-block__title">Habilidades blandas</h4>
        <div class="cv-tags-wrap">
          {member.cv.soft_skills.map((s: string) => <span class="soft-tag">{s}</span>)}
        </div>
      </div>
    )}

    <!-- Certificaciones — solo texto, sin link externo -->
    {member.cv.certifications?.length > 0 && (
      <div class="cv-block">
        <h4 class="cv-block__title">Certificaciones</h4>
        <div class="cv-certs">
          {member.cv.certifications.map((c: any) => (
            <div class="cert-item">
              <span class="cert-item__dot"></span>
              <span class="cert-item__name">{c.name}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Idiomas -->
    {member.cv.languages?.length > 0 && (
      <div class="cv-block">
        <h4 class="cv-block__title">Idiomas</h4>
        <div class="cv-tags-wrap">
          {member.cv.languages.map((l: string) => <span class="soft-tag">{l}</span>)}
        </div>
      </div>
    )}

  </div>
</div>

<style>
/* ═══════════════════════════════
   CARD
═══════════════════════════════ */
.card {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: 20px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: border-color .3s, transform .3s, box-shadow .3s;
}
.card:hover {
  border-color: rgba(16,185,129,.4);
  transform: translateY(-6px);
  box-shadow: 0 20px 40px rgba(0,0,0,.35);
}

/* visual */
.card__visual {
  position: relative;
  height: 210px;
  overflow: hidden;
  background: var(--bg-surface-2);
}
.card__photo {
  width: 100%; 
  height: 300px;
  object-fit: cover;
  transition: transform .5s ease;
}
.card:hover .card__photo { transform: scale(1.07); }
.card__avatar {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 4.5rem; font-weight: 800; color: var(--color-primary);
  background: linear-gradient(135deg, var(--bg-surface-2), var(--bg-base));
}
.card__overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, var(--bg-surface) 0%, transparent 55%);
}
.card__role-badge {
  position: absolute; bottom: 12px; left: 14px;
  background: rgba(16,185,129,.12);
  border: 1px solid rgba(16,185,129,.25);
  color: var(--color-primary);
  font-size: .7rem; font-weight: 700;
  letter-spacing: .07em; text-transform: uppercase;
  padding: 4px 10px; border-radius: 999px;
  backdrop-filter: blur(4px);
}

/* body */
.card__body {
  padding: 18px 20px 20px;
  display: flex; flex-direction: column; gap: 12px;
  flex: 1;
}
.card__name {
  font-size: 1.05rem; font-weight: 800;
  color: var(--text-primary); margin: 0;
}
.card__desc {
  font-size: .82rem; color: var(--text-muted);
  line-height: 1.6; margin: 0;
}

/* skill chips */
.card__skills { display: flex; flex-wrap: wrap; gap: 6px; }
.skill-chip {
  background: var(--bg-surface-2);
  border: 1px solid var(--border-color);
  color: var(--text-muted);
  font-size: .72rem; font-weight: 600;
  padding: 3px 9px; border-radius: 6px;
}

/* social links */
.card__links { display: flex; gap: 8px; flex-wrap: wrap; }
.social-link {
  display: inline-flex; align-items: center; gap: 5px;
  background: var(--bg-surface-2);
  border: 1px solid var(--border-color);
  color: var(--text-muted);
  font-size: .75rem; font-weight: 600;
  padding: 5px 10px; border-radius: 8px;
  text-decoration: none;
  transition: all .2s;
}
.social-link:hover {
  border-color: rgba(16,185,129,.35);
  color: var(--color-primary);
  background: rgba(16,185,129,.06);
}

/* cv button (abre modal) */
.card__cv-btn {
  margin-top: auto;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; padding: 11px;
  background: rgba(16,185,129,.08);
  border: 1px solid rgba(16,185,129,.2);
  border-radius: 10px;
  color: var(--color-primary);
  font-size: .84rem; font-weight: 700;
  font-family: var(--font-primary);
  cursor: pointer;
  transition: all .2s;
}
.card__cv-btn:hover {
  background: rgba(16,185,129,.15);
  border-color: rgba(16,185,129,.45);
  transform: translateY(-1px);
}

/* ── Botón PDF ── */
.card__pdf-btn {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; padding: 12px;
  background: var(--bg-surface-2);
  border-top: 1px solid var(--border-color);
  color: var(--text-muted);
  font-size: .84rem; font-weight: 700;
  font-family: var(--font-primary);
  text-decoration: none;
  transition: all .2s;
  /* sin border-radius: se pega al fondo del card redondeado */
}
.card__pdf-btn:hover {
  background: rgba(16,185,129,.08);
  color: var(--color-primary);
  border-top-color: rgba(16,185,129,.25);
}

/* ═══════════════════════════════
   CV MODAL
═══════════════════════════════ */
.cv-modal {
  display: none;
  position: fixed; inset: 0; z-index: 1000;
  align-items: center; justify-content: center;
  padding: 20px;
}
.cv-modal.is-open { display: flex; animation: fadeIn .25s ease; }

.cv-modal__backdrop {
  position: absolute; inset: 0;
  background: rgba(2,6,23,.9);
  backdrop-filter: blur(8px);
  cursor: pointer;
}

.cv-modal__panel {
  position: relative; z-index: 2;
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: 24px;
  width: 100%; max-width: 620px;
  max-height: 88vh; overflow-y: auto;
  padding: 36px 36px 40px;
  display: flex; flex-direction: column; gap: 24px;
  scrollbar-width: thin;
  scrollbar-color: var(--border-color) transparent;
}

.cv-modal__close {
  position: absolute; top: 16px; right: 16px;
  width: 34px; height: 34px;
  background: var(--bg-surface-2);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; color: var(--text-muted);
  transition: all .2s;
}
.cv-modal__close:hover {
  background: rgba(16,185,129,.1);
  color: var(--color-primary);
  border-color: rgba(16,185,129,.3);
}

/* header */
.cv-header { display: flex; gap: 18px; align-items: center; }
.cv-header__photo {
  width: 76px; height: 76px; border-radius: 50%;
  overflow: hidden; flex-shrink: 0;
  border: 2px solid rgba(16,185,129,.3);
  background: var(--bg-surface-2);
  display: flex; align-items: center; justify-content: center;
  font-size: 2rem; font-weight: 800; color: var(--color-primary);
}
.cv-header__photo img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
.cv-header__info h2 {
  font-size: 1.3rem; font-weight: 800;
  color: var(--text-primary); margin: 0 0 4px;
}
.cv-role {
  display: block; font-size: .75rem; font-weight: 700;
  color: var(--color-primary); text-transform: uppercase;
  letter-spacing: .08em; margin-bottom: 10px;
}
.cv-socials { display: flex; gap: 10px; flex-wrap: wrap; }
.cv-socials a {
  font-size: .78rem; color: var(--text-muted);
  text-decoration: none;
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 1px; transition: all .2s;
}
.cv-socials a:hover { color: var(--color-primary); border-color: var(--color-primary); }

/* blocks */
.cv-block { border-top: 1px solid var(--border-color); padding-top: 20px; }
.cv-block__title {
  font-size: .7rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .1em;
  color: var(--color-primary); margin: 0 0 12px;
}
.cv-block__text {
  font-size: .88rem; color: var(--text-secondary);
  line-height: 1.7; margin: 0;
}

/* skill rows */
.cv-skill-row { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 8px; }
.cv-skill-row__label {
  font-size: .75rem; font-weight: 600; color: var(--text-muted);
  min-width: 100px; white-space: nowrap; padding-top: 3px;
}
.cv-skill-row__tags { display: flex; flex-wrap: wrap; gap: 5px; }
.skill-tag {
  background: var(--bg-surface-2);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  font-size: .75rem; font-weight: 500;
  padding: 3px 9px; border-radius: 6px;
}

/* soft tags */
.cv-tags-wrap { display: flex; flex-wrap: wrap; gap: 7px; }
.soft-tag {
  background: rgba(16,185,129,.08);
  border: 1px solid rgba(16,185,129,.2);
  color: var(--color-primary);
  font-size: .8rem; font-weight: 600;
  padding: 4px 12px; border-radius: 8px;
}

/* certifications — solo display, sin link */
.cv-certs { display: flex; flex-direction: column; gap: 8px; }
.cert-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px;
  background: var(--bg-surface-2);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  color: var(--text-secondary);
  font-size: .85rem; font-weight: 500;
}
.cert-item__dot {
  width: 7px; height: 7px; flex-shrink: 0;
  background: var(--color-primary); border-radius: 50%;
}
.cert-item__name { flex: 1; }

@keyframes fadeIn {
  from { opacity: 0; } to { opacity: 1; }
}

@media (max-width: 540px) {
  .cv-modal__panel { padding: 24px 18px 28px; }
  .cv-header { flex-direction: column; align-items: flex-start; }
}
</style>

<script>
  // Abrir modal
  document.querySelectorAll('[data-open-cv]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = (btn as HTMLElement).dataset.openCv;
      document.getElementById(`cv-${id}`)?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    });
  });

  // Cerrar modal (backdrop + botón X)
  document.querySelectorAll('[data-close-cv]').forEach(el => {
    el.addEventListener('click', () => {
      const id = (el as HTMLElement).dataset.closeCv;
      document.getElementById(`cv-${id}`)?.classList.remove('is-open');
      document.body.style.overflow = '';
    });
  });

  // Cerrar con Escape
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.cv-modal.is-open').forEach(m => {
        m.classList.remove('is-open');
        document.body.style.overflow = '';
      });
    }
  });
</script>