---
// src/components/contact/MapSection.astro
---
<section class="map-section">
  <div class="map-container">
    <h2 class="section-title">Encuéntranos Aquí</h2>
    <div class="iframe-wrapper">
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3899.799741654744!2d-76.97404472508886!3d-12.194025344659744!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105b9a26836ac01%3A0x4fd233c0d43ca479!2sUniversidad%20Tecnol%C3%B3gica%20del%20Per%C3%BA%20UTP!5e0!3m2!1ses-419!2spe!4v1784074458401!5m2!1ses-419!2spe" 
        width="100%" 
        height="100%" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="strict-origin-when-cross-origin">
      </iframe>
    </div>
  </div>
</section>

<style>
  .map-section {
    padding: 4rem 1rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }
  .section-title {
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 3rem;
    color: var(--text-primary);
  }
  .map-container {
    background: var(--bg-surface, #0f172a);
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid var(--border-color, #1e293b);
  }
  .iframe-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    height: 0;
    overflow: hidden;
    border-radius: 8px;
  }
  .iframe-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(1) invert(0.9) hue-rotate(180deg) contrast(1.1); /* Dark mode map styling */
  }
</style>
